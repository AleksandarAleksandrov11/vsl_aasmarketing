# Variables de entorno de la landing (Vercel > Settings > Environment Variables).
# Copia este archivo a .env.local solo para probar en tu ordenador (npm run dev).
# Nunca subas valores reales al repositorio.
# Tipo en Vercel: Secret (solo escritura) para META_CAPI_TOKEN, SHEET_SECRET y
# UPSTASH_REDIS_REST_TOKEN; Config para el resto. Entorno: Production (en Preview,
# sin las de Meta ni las del Sheet real, para no mezclar pruebas con datos reales).
# IMPORTANTE: después de guardar o cambiar una variable en Vercel hay que hacer
# Redeploy (Deployments > ⋯ > Redeploy). Sin Redeploy no se aplica.

# ---------- Meta (píxel y API de conversiones) ----------
# [PENDIENTE] ID del conjunto de datos (píxel), solo cifras. Sale en el Administrador
# de eventos. Es el único sitio donde se pone: el build lo inyecta en la página
# y las funciones lo leen. Si está vacío, no se carga el píxel ni se envía nada a Meta.
META_PIXEL_ID=

# [PENDIENTE] Token de la API de conversiones (Administrador de eventos > conjunto
# de datos > Configuración > API de conversiones > Generar token de acceso).
META_CAPI_TOKEN=

# Solo para "Probar eventos" en el Administrador de eventos (por ejemplo TEST12345).
# En producción, VACÍO: si tiene valor, Meta trata los eventos como de prueba.
META_TEST_EVENT_CODE=

# true (por defecto): todos los eventos van por servidor acepten o no las
# cookies, salvo que el visitante se oponga («Medición desde el servidor»
# desactivada o «Rechazar todo» en Configurar cookies). El píxel del navegador,
# solo con consentimiento.
# false: por servidor solo si aceptan las cookies de marketing.
# El aviso de cookies y la política de privacidad se adaptan solos al hacer Redeploy.
CAPI_WITHOUT_CONSENT=true

# ---------- Google Sheets (Apps Script) ----------
# URL de la aplicación web del Apps Script (termina en /exec). Ver apps-script/README.md
SHEET_WEBHOOK_URL=
# Clave larga inventada por ti. La misma en las propiedades del script.
SHEET_SECRET=

# ---------- Opcionales ----------
# Vercel Web Analytics y Speed Insights (activados por defecto). Solo se cargan si
# el visitante acepta la analítica en el aviso de cookies. Actívalos también en el
# panel de Vercel (pestañas Analytics y Speed Insights del proyecto) o los scripts
# darían error 404. Pon false si no los vas a usar.
VERCEL_ANALYTICS=true

# [OPCIONAL, decide Aleks] Copia de cada solicitud en una base de datos propia
# (Upstash Redis, desde Vercel > Storage / Marketplace). Desactivada por defecto.
# Si la integración crea KV_REST_API_URL y KV_REST_API_TOKEN, también valen.
LEADS_DB_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
